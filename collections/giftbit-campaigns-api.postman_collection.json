                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contacts\": [\n    {\n      \"email\": \"<email>\",\n      \"firstname\": \"<string>\",\n      \"lastname\": \"<string>\"\n    },\n    {\n      \"email\": \"<email>\",\n      \"firstname\": \"<string>\",\n      \"lastname\": \"<string>\"\n    }\n  ],\n  \"price_in_cents\": \"<integer>\",\n  \"id\": \"<string>\",\n  \"message\": \"<string>\",\n  \"subject\": \"<string>\",\n  \"gift_template\": \"<string>\",\n  \"brand_codes\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"region\": \"<string>\",\n  \"expiry\": \"<date>\"\n}",
