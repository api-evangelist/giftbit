            "description": {
              "content": "Places an order for one or more emailed rewards. Supports single-brand and full-catalog (multi-brand) reward offers. A client-supplied `id` makes this operation idempotent — resend safely on unexpected errors.\n",
              "type": "text/plain"
            },
            "url": {
