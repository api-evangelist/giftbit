                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currencyisocode\": \"<string>\",\n  \"fund_amount_in_cents\": \"<integer>\",\n  \"id\": \"<string>\"\n}",
