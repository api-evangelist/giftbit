          "name": "List rewards",
          "request": {
            "name": "List rewards",
            "description": {
              "content": "Returns a paginated, filterable list of rewards across all orders. Supports filtering by delivery status, redemption status, date ranges, recipient name/email, and price range.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "gifts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "uuid",
                  "value": "<string>",
                  "description": "Return the reward with matching uuid."
                },
                {
                  "disabled": false,
                  "key": "campaign_uuid",
                  "value": "<string>",
                  "description": "Filter rewards by the order with the matching Giftbit UUID."
                },
                {
                  "disabled": false,
                  "key": "campaign_id",
                  "value": "<string>",
                  "description": "Filter rewards by the client-supplied order id."
                },
                {
                  "disabled": false,
                  "key": "price_in_cents_greater_than",
                  "value": "<integer>",
                  "description": "Filter rewards with price greater than this value in cents."
                },
                {
                  "disabled": false,
                  "key": "price_in_cents_less_than",
                  "value": "<integer>",
                  "description": "Filter rewards with price less than this value in cents."
                },
                {
                  "disabled": false,
                  "key": "recipient_name",
                  "value": "<string>",
                  "description": "Filter by recipient name (minimum 3 characters)."
                },
                {
                  "disabled": false,
                  "key": "recipient_email",
                  "value": "<string>",
                  "description": "Filter by recipient email (minimum 3 characters)."
                },
                {
                  "disabled": false,
                  "key": "delivery_status",
                  "value": "<string>",
                  "description": "Filter by delivery status. Options: UNSENT, DELIVERED, UNDELIVERABLE, TEMPORARILY_UNDELIVERABLE, UNSUBSCRIBED, COMPLAINT.\n"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by reward status. Options: SENT_AND_REDEEMABLE, REDEEMED, TO_CHARITY, GIVER_CANCELLED, EXPIRED.\n"
                },
                {
                  "disabled": false,
                  "key": "created_date_greater_than",
                  "value": "<string>",
                  "description": "Filter by created date. Format yyyy-MM-dd HH:mm:ss."
                },
                {
                  "disabled": false,
                  "key": "created_date_less_than",
                  "value": "<string>",
                  "description": "Filter by created date. Format yyyy-MM-dd HH:mm:ss."
                },
                {
                  "disabled": false,
                  "key": "delivery_date_greater_than",
                  "value": "<string>",
                  "description": "Filter by delivery date. Format yyyy-MM-dd HH:mm:ss."
                },
                {
                  "disabled": false,
                  "key": "delivery_date_less_than",
                  "value": "<string>",
                  "description": "Filter by delivery date. Format yyyy-MM-dd HH:mm:ss."
                },
                {
                  "disabled": false,
                  "key": "redelivery_count_greater_than",
                  "value": "<integer>",
                  "description": "Filter by redelivery count greater than this value."
                },
                {
                  "disabled": false,
                  "key": "redelivery_count_less_than",
                  "value": "<integer>",
                  "description": "Filter by redelivery count less than this value."
                },
                {
                  "disabled": false,
                  "key": "redeemed_date_greater_than",
                  "value": "<string>",
                  "description": "Filter by redeemed date. Format yyyy-MM-dd HH:mm:ss."
                },
                {
                  "disabled": false,
                  "key": "redeemed_date_less_than",
                  "value": "<string>",
                  "description": "Filter by redeemed date. Format yyyy-MM-dd HH:mm:ss."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Maximum number of rewards to return. Default 20."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Offset into results. Default 0."
                },
                {
                  "disabled": false,
                  "key": "sort",
