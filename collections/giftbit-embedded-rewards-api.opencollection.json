  },
  "items": [
    {
      "info": {
        "name": "Embedded Rewards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create embedded reward",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.giftbit.com/papi/v1/embedded",
            "body": {
              "type": "json",
              "data": "{}"
